# Cloudflare Pages headers (copied from public/ to the build root).

# Content-hashed assets: safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML shell + service worker: always revalidate so deploys/updates are picked up.
# Link (RFC 8288) lets agents find the site description, docs, and license
# without parsing HTML.
/
  Cache-Control: public, max-age=0, must-revalidate
  Link: </llms.txt>; rel="describedby", <https://github.com/ekarad1um/Nagami>; rel="service-doc", <https://github.com/ekarad1um/Nagami/blob/main/LICENSE>; rel="license"
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Sample shader: default type is octet-stream; set the real type so it compresses.
/example.wgsl
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
